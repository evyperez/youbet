{
  "name": "youbet",
  "version": "0.3.0",
  "description": "youbet website",
  "main": "index.scss",
  "scripts": {
    "prebuild": "npm-run-all --parallel lint clean",
    "build": "cross-env NODE_ENV=production npm run build:css",
    "postbuild": "hugo --gc --minify --cleanDestinationDir $([ \"$CONTEXT\" != \"production\" ] && [ -n \"$DEPLOY_PRIME_URL\" ] && echo \"--baseURL $DEPLOY_PRIME_URL\")",
    "clean": "rimraf --glob \"./public/**/*.*\"",
    "lint": "npm-run-all --parallel lint:*",
    "lint:es": "eslint \"assets/scripts/**/*.js\"",
    "lint:sass": "stylelint 'assets/stylesheets/**/*.scss'",
    "lint:markdown": "markdownlint \"*.md\" \"content/**/*.md\"",
    "prettier:write": "prettier --write .",
    "sass:fix": "stylelint 'assets/stylesheets/**/*.scss' --fix",
    "build:css": "mkdir -p static/dist/css && sass assets/stylesheets/index.scss static/dist/css/main.css --no-source-map --load-path=assets/stylesheets",
    "build:css:watch": "mkdir -p static/dist/css && sass assets/stylesheets/index.scss static/dist/css/main.css --no-source-map --load-path=assets/stylesheets --watch",
    "start": "npm run build:css && npm-run-all --parallel start:hugo start:css:watch",
    "start:hugo": "cross-env NODE_ENV=development hugo server --noHTTPCache --ignoreCache --disableFastRender --poll 1s",
    "start:css:watch": "npm run build:css:watch",
    "test": "npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evyperez/youbet"
  },
  "keywords": [
    "html",
    "hugo",
    "npm",
    "sass"
  ],
  "author": "Evelyn Perez e Stephanie Castro",
  "license": "MIT",
  "homepage": "http://youbetschool.com",
  "dependencies": {
    "@glidejs/glide": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "markdownlint-cli": "^0.50.0",
    "modularscale-sass": "^3.0.10",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "prettier-plugin-go-template": "^0.0.15",
    "rimraf": "^6.1.3",
    "sass": "^1.107.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.4.0"
  },
  "overrides": {
    "katex": "^0.19.1",
    "re2js": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
